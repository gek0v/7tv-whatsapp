<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <intent>
            <action android:name="com.whatsapp.intent.action.ENABLE_STICKER_PACK" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/webp" />
        </intent>
        <provider android:authorities="com.whatsapp.provider.sticker_whitelist_check" />
        <provider android:authorities="com.whatsapp.w4b.provider.sticker_whitelist_check" />
    </queries>

    <application
        android:name=".SevenTvApplication"
        android:theme="@style/Theme.SevenTvStickers"
        android:allowBackup="true"
        android:largeHeap="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="com.seventv.stickers.whatsapp.StickerContentProvider"
            android:authorities="com.seventv.stickers.stickercontentprovider"
            android:enabled="true"
            android:exported="true"
            android:readPermission="com.whatsapp.sticker.READ" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.seventv.stickers.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
